# Telegram app credentials from https://my.telegram.org/apps
# Keep these private. Do not commit a real .env.
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=""

# Optional defaults.
STOLAS_TG_CONFIG=config/accounts.local.json
STOLAS_TG_ALLOWLIST=config/allowlist.local.json

# Optional: common Telegram Desktop tdata location on Windows.
# STOLAS_TDATA_PATH=C:\Users\PC\AppData\Roaming\Telegram Desktop\tdata
